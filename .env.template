# vast-comfy environment template
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# The tool loads `.env` only when you explicitly pass `--env-file .env`;
# otherwise values are read from your process environment.
#
# YAML config files only reference the *names* of these variables, never the values.

# --- Required for any Vast.ai API call (search / rent / manage) ---
# Create at https://cloud.vast.ai/manage-keys/ . Stays on the control machine only;
# it is never uploaded to the instance.
VAST_API_KEY=

# --- Optional: Hugging Face token ---
# The default Anima models are public; a token is NOT needed for them.
# Only set this if you add gated/private Hugging Face files to config/models.yaml.
HF_TOKEN=

# --- Optional: CivitAI API token ---
# Only needed if you add CivitAI-hosted files to config/models.yaml.
CIVITAI_TOKEN=
